<resources>
    <style name="Sample" parent="android:Theme.DeviceDefault.DayNight">
        <!-- Dark status and navigation bar icons on the light theme, light ones on the dark theme. -->
        <item name="android:windowLightStatusBar">?android:attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?android:attr/isLightTheme</item>
    </style>
    <style name="Sample.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
